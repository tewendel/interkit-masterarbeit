FROM node:15-alpine

ARG BUILD_SOURCE_PATH
ARG BUILD_REPOSITORIES_PATH

WORKDIR /app

# copy shared files and install dependencies
COPY /shared /shared
RUN cd /shared && npm ci

# copy app files and install dependencies
COPY ${BUILD_SOURCE_PATH} ./
RUN npm ci

# set repositories path in container
ENV REPOSITORIES_PATH=/var/repositories
# Copy repositories folder
COPY ${BUILD_REPOSITORIES_PATH} ${REPOSITORIES_PATH}
# set REPOSITORIES_PATH at runtime
RUN echo "REPOSITORIES_PATH=${REPOSITORIES_PATH}" > .env

CMD ["npm", "start"]
