ARG INTERKIT_BASE_TAG=latest
FROM interkit/interkit-packages:${INTERKIT_BASE_TAG} AS interkit-packages
FROM node:15-alpine

ARG BUILD_SOURCE_PATH=./svelte-admin

WORKDIR /app

# copy shared files
COPY --from=interkit-packages /packages /packages

# copy app files and install dependencies
COPY ${BUILD_SOURCE_PATH} ./
RUN npm ci

# build
RUN npm run build

CMD ["npm", "start"]
