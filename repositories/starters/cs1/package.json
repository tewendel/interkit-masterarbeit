{
  "name": "interkit-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run sub-globals-from-dotenv && rollup -c",
    "start": "npm run sub-globals-from-dotenv && sirv public",
    "sub-globals-from-dotenv": "envsub -s dollar-basic -f .env src/globals.envsub.js public/build/globals.js",
    "dev": "npm run sub-globals-from-dotenv && rollup -c -w"
  },
  "devDependencies": {
    "@babel/core": "^7.13.14",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.13.8",
    "@babel/plugin-proposal-optional-chaining": "^7.13.12",
    "@babel/preset-env": "^7.13.12",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^3.0.0-rc.0",
    "@capacitor/cli": "^3.0.0-rc.0",
    "@capacitor/ios": "^3.0.0-rc.0",
    "@capacitor/android": "^3.0.0-rc.0",
    "envsub": "^4.0.7",
    "leaflet": "^1.7.1",
    "sirv-cli": "^1.0.0"
  },
  "workspaces": [
    "../../../packages/*"
  ],
  "engines": {
    "node": "15",
    "npm": "7"
  }
}
