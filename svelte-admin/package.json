{
  "name": "interkit-admin",
  "version": "1.0.0",
  "scripts": {
    "preinstall": "check-engine",
    "sub-globals-from-dotenv": "mkdir -p dist && envsub -s dollar-basic -f .env public/globals.envsub.js public/autogenerated_globals.js",
    "sub-globals-from-env": "mkdir -p dist && envsub -s dollar-basic public/globals.envsub.js dist/autogenerated_globals.js",
    "dev": "npm run sub-globals-from-dotenv && vite --host",
    "build": "vite build",
    "preview": "npm run sub-globals-from-dotenv && vite preview",
    "start": "npm run sub-globals-from-env && sirv dist --host 0.0.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^2.0.2",
    "check-engine": "^1.10.0",
    "svelte": "^3.55.0",
    "svelte-highlight": "^0.7.1",
    "vite": "^4.0.4"
  },
  "dependencies": {
    "@google/model-viewer": "^1.8.0",
    "@rollup/plugin-json": "^4.1.0",
    "ansi-to-html": "^0.6.14",
    "blockly": "^4.20201217.0",
    "carbon-components-svelte": "^0.63.8",
    "carbon-icons-svelte": "^11.0.1",
    "codemirror": "^5.63.3",
    "dayjs": "^1.10.7",
    "envsub": "^4.0.7",
    "install": "^0.13.0",
    "interkit-dev": "*",
    "js-beautify": "^1.14.6",
    "leaflet": "^1.7.1",
    "marked": "^2.0.3",
    "npm": "^7.10.0",
    "sirv-cli": "^1.0.0",
    "svelte-file-dropzone": "^0.0.15",
    "svelte-qrcode": "^0.0.2",
    "svelte-spa-router": "^3.1.0",
    "svelte-watch-resize": "^1.0.3",
    "xml-formatter": "^2.4.0",
    "yaml": "^2.0.0-3"
  },
  "workspaces": [
    "../packages/*"
  ],
  "type": "module",
  "engines": {
    "node": "16",
    "npm": ">=7"
  }
}
