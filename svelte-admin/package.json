{
  "name": "interkit-admin",
  "version": "1.0.0",
  "scripts": {
    "build": "rollup -c",
    "preinstall": "check-engine",
    "sub-globals-from-dotenv": "envsub -s dollar-basic -f .env src/globals.envsub.js public/build/globals.js",
    "sub-globals-from-env": "envsub -s dollar-basic src/globals.envsub.js public/build/globals.js",
    "dev": "npm run sub-globals-from-dotenv && rollup -c -w",
    "start": "npm run sub-globals-from-env && sirv public --host 0.0.0.0",
    "serve:dev": "npm run sub-globals-from-dotenv && sirv public --dev --no-clear"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "check-engine": "^1.10.0",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.35.0"
  },
  "dependencies": {
    "@rollup/plugin-json": "^4.1.0",
    "ansi-to-html": "^0.6.14",
    "blockly": "^4.20201217.0",
    "carbon-components-svelte": "^0.32.1",
    "envsub": "^4.0.7",
    "install": "^0.13.0",
    "interkit-dev": "*",
    "leaflet": "^1.7.1",
    "npm": "^7.10.0",
    "sirv-cli": "^1.0.0",
    "svelte-qrcode": "^0.0.2",
    "svelte-spa-router": "^3.1.0",
    "yaml": "^2.0.0-3"
  },
  "workspaces": [
    "../packages/*"
  ],
  "engines": {
    "node": "15",
    "npm": "7"
  }
}
